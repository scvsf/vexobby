    end

    task.spawn(function()
        local stageCounter = 0
        while autoFarmActive_2 do
            local currentStage = getMyStage()
            if currentStage and currentStage < MAX_STAGE_2 then
                local targetStage = currentStage + 1
                teleport_2(targetStage, false)
                
                local startTime = tick()
                local updated = false
                while tick() - startTime < 2.0 do
                    task.wait(0.05)
                    if not autoFarmActive_2 then break end
                    local newStage = getMyStage()
                    if newStage and newStage >= targetStage then
                        updated = true
                        break
                    end
                end
                
