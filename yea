local function SaveState(tabIndex, isFarming)
    local state = { Tab = tabIndex, Farming = isFarming }
    pcall(function()
        writefile(SAVE_FILE, game:GetService("HttpService"):JSONEncode(state))
    end)
end

local function LoadState()
    local success, content = pcall(function() return readfile(SAVE_FILE) end)
    if success and content then
        local success2, data = pcall(function() return game:GetService("HttpService"):JSONDecode(content) end)
        if success2 and data then return data end
    end
    return { Tab = 1, Farming = false }
end

