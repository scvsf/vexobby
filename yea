local TARGET_FOLDER_1 = "Checkpoints"
local MAX_STAGE_1 = 260
local MIN_STAGE_1 = 1
local useTween_1 = true

local function getFolder_1()
    local refs = Workspace:FindFirstChild("References")
    if refs then return refs:FindFirstChild(TARGET_FOLDER_1) end
    return Workspace:FindFirstChild(TARGET_FOLDER_1)
end

local function scanBounds_1()
    local folder = getFolder_1()
    if not folder then return MIN_STAGE_1, MAX_STAGE_1 end
    local lowest = math.huge; local highest = -math.huge
    for _, child in ipairs(folder:GetChildren()) do
        local cpNo = child:GetAttribute("CheckpointNO")
        if cpNo and type(cpNo) == "number" then
            if cpNo < lowest then lowest = cpNo end
            if cpNo > highest then highest = cpNo end
        end
    end
    if lowest == math.huge then lowest = 1 end
    if highest == -math.huge then highest = 260 end
    return lowest, highest
end

local function buildMap_1()
    local map = {}; local folder = getFolder_1()
    if not folder then return map end
    for _, child in ipairs(folder:GetChildren()) do
        local cpNo = child:GetAttribute("CheckpointNO")
        if cpNo and type(cpNo) == "number" then map[cpNo] = child end
    end
    return map
end

MIN_STAGE_1, MAX_STAGE_1 = scanBounds_1()

local function teleport_1(stageNum, isFallback)
    stageNum = math.clamp(tonumber(stageNum) or MIN_STAGE_1, MIN_STAGE_1, MAX_STAGE_1)
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local map = buildMap_1()
    local part = map[stageNum]
    
    if not part then
        local best, bestN = nil, -1
        for n, child in pairs(map) do
            if n <= stageNum and n > bestN then bestN, best = n, child end
        end
        part = best
    end
    
    if not part then return false end

    local targetPart = part:FindFirstChild("Hitbox") or part:FindFirstChildWhichIsA("BasePart")
    if not targetPart and part:IsA("BasePart") then targetPart = part end
    if not targetPart then return false end

    local targetCFrame = targetPart.CFrame
    local touchInterest = targetPart:FindFirstChild("TouchInterest")

    pcall(function()
        if isFallback then
            hrp.CFrame = targetCFrame + Vector3.new(0, 30, 0)
            hrp.AssemblyLinearVelocity = Vector3.new(0, -50, 0)
        elseif useTween_1 then
            local tweenInfo = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            local t1 = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame + Vector3.new(0, 3, 0)})
            t1:Play(); t1.Completed:Wait()
            
            hrp.AssemblyLinearVelocity = Vector3.new(math.random(-2,2), -10, math.random(-2,2))
            task.wait(0.15)
            
            if touchInterest and touchInterest.Parent then firetouchinterest(hrp, targetPart, 0) end
            task.wait(0.15)
            if touchInterest and touchInterest.Parent then firetouchinterest(hrp, targetPart, 1) end
            
            hrp.CFrame = targetCFrame + Vector3.new(0, 5, 0)
        else
            hrp.CFrame = targetCFrame + Vector3.new(0, 3, 0)
            task.wait(0.15)
            if touchInterest and touchInterest.Parent then firetouchinterest(hrp, targetPart, 0) end
            task.wait(0.15)
            if touchInterest and touchInterest.Parent then firetouchinterest(hrp, targetPart, 1) end
            hrp.CFrame = targetCFrame + Vector3.new(0, 5, 0)
        end
    end)
    return true
end

